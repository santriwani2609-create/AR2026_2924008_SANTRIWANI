  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "The primary function of the <b>Sprite Editor</b> is to efficiently slice sprite sheets into separate sprites. In this case, you\u2019ll slice your animal\u2019s sheet into eight individual sprites."
