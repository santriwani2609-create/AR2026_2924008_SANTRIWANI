  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "If you put a rug in your scene right now, it might sit on top of the furniture. Rugs don\u2019t usually do that. You\u2019ll need to use the <b>Order in Layer</b> property of the <b>Sprite Renderer</b> component to control exactly how your objects are stacked in 2D space. \n\nThis will allow you to strategically place the rug beneath furniture and other movable objects, but still above the floor. "
