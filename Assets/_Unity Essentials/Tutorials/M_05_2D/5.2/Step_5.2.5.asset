  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "The furniture movement is not very realistic. Let's make the furniture behave more appropriately when the player pushes it. The <b>Rigidbody 2D</b> component\u2019s <b>linear and angular damping</b> values simulate resistance that objects encounter when moving."
