  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  From the <b>Hierarchy</b> window, select all four walls. \n\n<b>2.</b>  In the <b>Sprite Renderer</b> component, for the <b>Color</b> property, select the color box and use the <b>Color</b> window to select a new color for the walls. You can even use the dropper tool to select a color from the existing scene. "
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
