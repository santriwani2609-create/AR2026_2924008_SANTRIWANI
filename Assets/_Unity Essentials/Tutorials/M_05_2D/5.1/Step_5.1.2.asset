  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  In the <b>Project</b> window, go to <b>_Unity Essentials</b> > <b>Scenes,</b> then double-click <b>5_TopDown_2D_Scene</b> to open it.\n\n<b>2.</b>  With the scene open, browse through the <b>Hierarchy</b> window to identify the GameObjects in the scene: \n\n\u2022 <b>A Main Camera:</b> This camera is configured to use <b>Orthographic</b> mode instead of the default 3D <b>Perspective</b> mode, which is necessary for 2D gameplay.\n\u2022 <b>A Floor:</b> This is an image of an empty wood floor, which will be seen from a top-down perspective.\n\n<b>3.</b>  In the <b>Hierarchy</b> window, double-click the <b>Floor</b> GameObject to frame it in the <b>Scene</b> view, then orbit around the floor using <b>Alt+left-click</b> (macOS: <b>Option+left-click</b>) to see that it is completely flat."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &7663006144374534989
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
