  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: Unity offers a specialized 2D view of your scene. This view removes the forward-to-back Z-axis entirely, and instead focuses just on the X- and Y-axes. This adjustment restricts scene navigation to just panning and zooming.
