  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Next, you\u2019ll add a player controller script that allows you to control the movements of the 2D player. \n\nUnlike Unity's built-in components, such as the <b>Rigidbody 2D</b> component, <b>PlayerController2D</b> is a custom script we\u2019ve provided for you designed to manage player inputs and movements within a 2D environment."
