  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Just like you did in the living room scene, you\u2019ll now add a player character to the scene. You\u2019ll have the same selection of characters (a robot vacuum, a toy car, etc), but this time they will be 2D sprites instead of 3D models. <b>Sprites</b> are 2D graphics that are used to represent characters, objects, and other elements within a game."
