  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  If the <b>0_MainMenu_Scene</b> is not already open, open it now. \n\n<b>2.</b>  In the <b>Hierarchy</b> window, expand <b>Canvas</b> > <b>Panels_SceneSelect</b> > <b>Panel_SceneList</b> and select the <b>Bonus_Button</b> GameObject.\n\n<b>3.</b>  At the top of the <b>Inspector</b> window, use the checkbox to activate the GameObject and make the <b>Bonus_Button</b> visible in the scene.\n\n<b>4.</b>  Return to the <b>Build Profiles</b> by selecting <b>File</b> > <b>Build Profiles</b>, then drag the <b>6_Bonus_Custom_Scene</b> to the bottom of the <b>Scene List</b>."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
