  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  Add an <b>Audio Source</b> component to the refrigerator and use the <b>Fridge-Hum</b> file for its audio clip. \n\n<b>2.</b>  Enable <b>Loop,</b> reduce the <b>Volume,</b> and set the <b>Spatial Blend</b> to <b>1</b> (full 3D).\n\n<b>Note:</b>  If you want, experiment with different <b>Min Distance</b> and <b>Max Distance</b> values in the 3D sound settings to see what feels most natural for the refrigerator humming sound."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
