  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  In the <b>Boiling Pot</b> GameObject\u2019s <b>Audio Source</b> component, locate the <b>Spatial Blend</b> property and drag the slider from <b>0</b> (fully 2D) to <b>1</b> (fully 3D). \n\n<b>2.</b>  Enter <b>Play</b> mode again to test your new 3D spatial audio effect. Move closer and farther away, and be sure to experience the stereo effect by rotating your view left and right relative to the boiling pot. \n\n<b>3.</b>  Exit <b>Play</b> mode."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
