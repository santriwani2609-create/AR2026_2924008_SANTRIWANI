  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "First, you\u2019ll go through the rings using the trusty technique that will serve you well through your Unity career: Frame, Orbit, Zoom!\n\nThis technique allows you to quickly focus on any GameObject from any angle you want."
