  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "To save your scene, press <b>Ctrl+S</b> <b>(macOS: Cmd+S).</b>\n\nIf there was an asterisk next to the scene name in the <b>Hierarchy</b> window, the asterisk would disappear. \n\n<b>Note:</b> You can also select <b>File</b> > <b>Save</b> from the main menu to save your scene."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
