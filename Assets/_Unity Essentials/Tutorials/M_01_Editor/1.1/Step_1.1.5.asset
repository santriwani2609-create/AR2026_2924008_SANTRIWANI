  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  In the Hierarchy window, double-click the <b>Stairs</b> GameObject to frame it in the Scene view.\n\n<b>2.</b>  Select the top tool from the toolbar that looks like a hand \u2014 this is the <b>Pan</b> tool.\n<b>Note:</b>  The Pan tool is the same as the <b>View</b> tool.\n\n<b>3.</b>  With the Pan tool selected, left-click and drag in the <b>Scene</b> view to pan side to side.\n\nNotice how you can see the changing reflection of the sky in the shiny material on the stairs as you pan side to side. You\u2019ll learn how to make your own materials later!"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
