  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'In this step, you''ll practice using Flythrough mode to zoom in and find a hidden number on the back of the swingset.


      In the video demo above, the number appears as a red square, but it will be a real number in your scene.


      Remember, you can always reorient yourself by double-clicking on a GameObject in the <b>Hierarchy</b> window.'
