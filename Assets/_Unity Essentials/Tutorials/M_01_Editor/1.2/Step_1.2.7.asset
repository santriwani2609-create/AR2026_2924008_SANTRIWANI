  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  Activate Flythrough mode in the <b>Scene</b> view by holding the right mouse button and using the <b>WASD</b> keys to navigate. \n\n<b>2.</b> Locate the hidden number on the back of the top bar of the swingset. \n\n<b>Tip:</b> You might want to write down the hidden numbers as you find them so you don't forget!"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
