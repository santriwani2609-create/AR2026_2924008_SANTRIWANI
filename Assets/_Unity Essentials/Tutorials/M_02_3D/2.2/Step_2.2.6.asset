  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b> Make sure that <b>Ball_Mat</b> material is selected in the <b>Project</b> window.\n\n<b>2.</b>  In the <b>Inspector</b> window, in the <b>Surface Inputs</b> section, for the <b>Base Map</b> property, select the white color swatch and use the <b>Color</b> window to choose a new color. \n\nObserve how your changes affect the ball's appearance.\n\n<b>3.</b>  Adjust the sliders for the <b>Metallic Map</b> and <b>Smoothness</b> properties to your liking."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &5178330411841209907
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "With your custom material now applied to the ball, you\u2019re ready to adjust the material\u2019s properties to your liking. You can customize the ball\u2019s color and how it interacts with light in the scene. Creating materials can get very complicated, so you\u2019ll start by adjusting just three key properties:\n\n\u2022 <b>Base Map Color:</b> The basic color of the object.\n\u2022 <b>Metallic Map:</b> How metallic the object looks.\n\u2022 <b>Smoothness:</b> How smooth the object looks."
