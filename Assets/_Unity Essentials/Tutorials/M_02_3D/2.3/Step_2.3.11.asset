  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: '<b>1.</b>  Select the <b>Ball</b> GameObject.


      <b>2.</b>  In the <b>Inspector</b> window, in the <b>Rigidbody</b> component, increase the mass to ensure it topples the block structure when it collides.


      <b>3.</b>  Enter Play mode and watch the blocks fly!


      <b>Note:</b>  Remember to save your scene often with <b>Ctrl+S</b> (macOS: <b>Cmd+S</b>).'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
