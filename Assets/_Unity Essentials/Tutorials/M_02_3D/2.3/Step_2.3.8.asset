    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In this step, you'll change the block\u2019s material using prefab editing mode so it\u2019s not that boring gray anymore. You'll see the power of prefabs once again, as you modify a single asset and see the change instantly reflected across all instances of that prefab. "
