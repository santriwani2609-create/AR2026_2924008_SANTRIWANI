  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'A <b>skybox</b> in Unity is a type of virtual backdrop that surrounds the entire scene, giving the illusion of a distant environment or sky around the environment you create.


      The skybox contributes a lot to the overall feel of your scene.'
