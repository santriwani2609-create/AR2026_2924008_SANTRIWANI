    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Next, you'll apply your script to the player object. \n\nHere's a fun fact: in Unity, the scripts you write in C# are components, similar to the <b>Rigidbody,</b> <b>Audio Source,</b> and other components you've worked with. The difference between the components you create and Unity's built-in components is that your custom components are editable."
--- !u!114 &-5301411372921750366
MonoBehaviour:
  m_ObjectHideFlags: 1
